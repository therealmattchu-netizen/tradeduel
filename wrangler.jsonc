{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tradeduel",
  "main": "./dist/server/server.js",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tradeduel-db",
      "database_id": "33196030-acd5-449e-85a6-8f3151aa07ba",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "TRADEDUEL_ALLOWED_ORIGINS": "http://localhost:5173,https://tradeduel.workers.dev",
    "TRADEDUEL_WALLET_DOMAIN": "tradeduel.workers.dev"
  }
}
